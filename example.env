# Sagashi environment variables

# Uruky API token (required for web search)
URUKY_TOKEN=your_uruki_api_token_here

# Reddit API credentials (required for Reddit search)
# Create a Reddit app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=sagashi/0.1 by your_username

# Optional: Bearer token for MCP server auth. When set, clients must send
# "Authorization: Bearer <token>" on every request. Leave unset for an open
# server (acceptable on a trusted local network).
# MCP_SEARCH_AUTH_TOKEN=your_auth_token_here

# Optional: Max characters for page content (default: 40000)
FETCH_MAX_CHARS=40000

# Optional: Path to a cookies.txt (Netscape format) for yt-dlp, used by the
# fetch_youtube_transcript tool. YouTube bot-checks the server's IP, so
# export it once with a browser extension (e.g. "Get cookies.txt LOCALLY")
# while signed in to YouTube. When unset, the transcript tool works until
# YouTube starts bot-checking.
# YOUTUBE_COOKIES_FILE=/app/cookies.txt

# Optional: llama-server /v1/rerank endpoint for cross-encoder reranking of
# search results (same approach as matomeru). The URL is the full endpoint,
# e.g. http://192.168.178.64:9093/v1/rerank. When unset, results are ranked
# with the built-in lexical term-overlap scorer instead.
# RERANKER_URL=http://192.168.178.64:9093/v1/rerank
# RERANKER_TOKEN=your_reranker_token_here

# Optional: Comma-separated list of browser origins allowed to call the server
# via CORS (needed for browser-based MCP clients). Default: allow all origins.
# CORS_ORIGINS=https://my-ui.example.com,http://192.168.178.10:9090

# Optional: Host port for the Docker deployment (default: 9092)
# SAGASHI_PORT=9092
