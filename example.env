# Sagashi environment template
# Copy this file to .env and fill in your credentials

# Uruky API (web search)
URUKY_TOKEN=your-uruky-token-here

# Reddit API
REDDIT_CLIENT_ID=your-reddit-client-id-here
REDDIT_CLIENT_SECRET=your-reddit-client-secret-here
REDDIT_USER_AGENT=sagashi/0.1.0 (by /u/your-username)

# Optional
# MCP_SEARCH_AUTH_TOKEN=your-bearer-token-here
